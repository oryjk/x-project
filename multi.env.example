# 多设备/多平台示例。新部署复制为 .env 后 chmod 600 .env，再在本机填写。
# 已有部署请在原 .env 中追加这些配置，首次 profiles 运行前保留旧 X_ACCOUNT/X_DEVICE_ID，
# 程序将持久化旧状态归属；不要覆盖正在使用的凭据。
X_ADB_PATH=adb
X_CODEX_PATH=codex
X_DEVICES=phone_a,phone_b
X_PROFILES=main_x,main_red,second_x

# 手机A：同一手机可以分别登录X和小红书，不自动切换同一平台的账号。
X_DEVICE_PHONE_A_ADB_HOST=
X_DEVICE_PHONE_A_ADB_PORT=
X_DEVICE_PHONE_A_ADB_SERIAL=
X_DEVICE_PHONE_A_DEVICE_ID=
X_DEVICE_PHONE_A_ALLOW_UNLOCK=false
X_DEVICE_PHONE_A_UNLOCK_METHOD=pin
X_DEVICE_PHONE_A_PHONE_PIN=
X_DEVICE_PHONE_A_PHONE_PATTERN=
X_DEVICE_PHONE_A_ADB_PAIR_HOST=
X_DEVICE_PHONE_A_ADB_PAIR_PORT=
X_DEVICE_PHONE_A_ADB_PAIR_CODE=

# 手机B：也可用ADB_SERIAL填写完整IP:端口或USB序列号。
X_DEVICE_PHONE_B_ADB_HOST=
X_DEVICE_PHONE_B_ADB_PORT=
X_DEVICE_PHONE_B_ADB_SERIAL=
X_DEVICE_PHONE_B_DEVICE_ID=
X_DEVICE_PHONE_B_ALLOW_UNLOCK=false
X_DEVICE_PHONE_B_UNLOCK_METHOD=pattern
X_DEVICE_PHONE_B_PHONE_PIN=
X_DEVICE_PHONE_B_PHONE_PATTERN=
X_DEVICE_PHONE_B_ADB_PAIR_HOST=
X_DEVICE_PHONE_B_ADB_PAIR_PORT=
X_DEVICE_PHONE_B_ADB_PAIR_CODE=

X_PROFILE_MAIN_X_PLATFORM=x
X_PROFILE_MAIN_X_DEVICE=phone_a
X_PROFILE_MAIN_X_ACCOUNT=
X_PROFILE_MAIN_X_ENABLED=false
X_PROFILE_MAIN_X_HOURLY_LIMIT=3
X_PROFILE_MAIN_X_MIN_INTERVAL_MINUTES=8
X_PROFILE_MAIN_X_PERSONA=

X_PROFILE_MAIN_RED_PLATFORM=xiaohongshu
X_PROFILE_MAIN_RED_DEVICE=phone_a
# 小红书号，必须可在界面独立核对；不使用可能重名的昵称。
X_PROFILE_MAIN_RED_ACCOUNT=
X_PROFILE_MAIN_RED_ENABLED=false
X_PROFILE_MAIN_RED_HOURLY_LIMIT=1
X_PROFILE_MAIN_RED_MIN_INTERVAL_MINUTES=30
X_PROFILE_MAIN_RED_PERSONA=
# 当前手机发布端支持一张封面；数组留空时用Pillow和中文字体生成文字卡片。
# 路径可相对于项目配置目录，JSON数组必须保留引号。
X_PROFILE_MAIN_RED_IMAGES=[]
X_PROFILE_MAIN_RED_FONT_PATH=

X_PROFILE_SECOND_X_PLATFORM=x
X_PROFILE_SECOND_X_DEVICE=phone_b
X_PROFILE_SECOND_X_ACCOUNT=
X_PROFILE_SECOND_X_ENABLED=false
X_PROFILE_SECOND_X_HOURLY_LIMIT=2
X_PROFILE_SECOND_X_MIN_INTERVAL_MINUTES=20
X_PROFILE_SECOND_X_PERSONA=

# 可选公共网络和Codex认证配置同单账号示例；不要把手机凭据放入研究认证目录。
# CODEX_HOME=/path/to/codex-home
# HTTPS_PROXY=http://127.0.0.1:7890
