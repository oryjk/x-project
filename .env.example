# 复制为 .env 后先 chmod 600 .env，再在本机填写；不要提交或发到聊天中。
# 程序自动读取，不需要 source。值按字面读取，不执行 shell 插值。

# 必填：自己的 X 用户名（带不带 @ 均可）
X_ACCOUNT=

# ADB / Codex 可在 PATH 中，也可填写本机绝对路径（路径含空格时加引号）
X_ADB_PATH=adb
X_CODEX_PATH=codex

# 无线调试主页面显示的“IP 地址和端口”（连接端口）
X_ADB_HOST=
X_ADB_PORT=
# USB 或已知完整连接地址可用此项替代 HOST/PORT；二选一
X_ADB_SERIAL=

# 首次配对：在手机打开“使用配对码配对设备”，填写该弹窗中的端口和六位配对码。
# 配对端口与上面的连接端口通常不同；已配对后不需要这些项。
# 配对主机留空时使用 X_ADB_HOST。
X_ADB_PAIR_HOST=
X_ADB_PAIR_PORT=
X_ADB_PAIR_CODE=

# 先运行 connect 核对设备，再把返回的物理设备序列号填到这里。
# doctor、预览和发布前均强制核对，不能只填 IP 地址。
X_DEVICE_ID=

# 允许程序在任务期间解锁；失败一次即保护锁定，需要人工核对后 reset。
X_ALLOW_UNLOCK=false
X_UNLOCK_METHOD=pin
# pin: 4–16 位数字；pattern: 九宫格 1–9 点位，4–9 个不重复点。
# 只填写与 X_UNLOCK_METHOD 对应的一种凭据；已有 pwd=... 仍兼容。
X_PHONE_PIN=
X_PHONE_PATTERN=

# 可选：不配置时使用专业中文 AI/科技整理口吻
X_PERSONA=
# 可选：自定义 Codex 登录目录（不填写则使用当前用户默认目录）
# CODEX_HOME=/path/to/codex-home
# 可选：代理；同样可通过系统环境变量提供
# HTTPS_PROXY=http://127.0.0.1:7890
